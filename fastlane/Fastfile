fastlane_version "2.238.0"

default_platform(:ios)

platform :ios do
  def disable_swift_syntax_prebuilts!
    sh("mkdir -p ~/.swiftpm/cache/prebuilts && touch ~/.swiftpm/cache/prebuilts/noprebuilts")
  end

  desc "Build the Basic example app for PR validation"
  lane :build_basic do
    disable_swift_syntax_prebuilts!

    build_app(
      project: "Examples/Basic/Basic.xcodeproj",
      scheme: "Basic",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      clean: true,
      skip_archive: true,
      skip_package_ipa: true,
      skip_codesigning: true
    )
  end

  desc "Build the iOS 16 Basic example app for PR validation"
  lane :build_basic_ios16 do
    disable_swift_syntax_prebuilts!

    build_app(
      project: "Examples/Basic-iOS16/Basic-iOS16.xcodeproj",
      scheme: "Basic-iOS16",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      clean: true,
      skip_archive: true,
      skip_package_ipa: true,
      skip_codesigning: true
    )
  end
end
